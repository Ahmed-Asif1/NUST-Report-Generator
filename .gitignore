# ==============================================================================
# .gitignore — NUST Report Generator (Public Distribution Repository)
# ==============================================================================

# Executables & Archives (Must be hosted in GitHub Releases, not in git history)
*.exe
*.zip
*.tar.gz
*.7z
*.rar

# Builds & Outputs
build/
dist/
output/
release/

# Coursework & Student Data
*.docx
*.doc
*.pdf
manuals/
assets/
config/students.json
config/.license_key
config/.activation

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
